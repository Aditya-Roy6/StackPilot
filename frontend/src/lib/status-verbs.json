        "Lining up the pieces", "Preparing", "Sequencing", "Reserving capacity",
        "Reading the manifest", "Checking prerequisites", "Sanity-checking",
        "Confirming the target", "Warming the runtime", "Provisioning",
        "Reconciling", "Squaring the plan", "Double-checking", "Rehearsing",
        "Counting replicas", "Picking a port", "Wiring routes",
        "Checking the door is unlocked", "Making room", "Clearing the deck",
        "Taking a breath before the big one"
      ]
    },
    "diagnose": {
      "match": [
        "error", "fail", "failed", "failing", "broken", "crash", "crashed",
        "bug", "why", "debug", "diagnose", "wrong", "issue", "problem",
        "not working", "stuck", "timeout", "exception", "stack trace",
        "down", "outage", "incident", "restart loop", "oom"
      ],
      "verbs": [
        "Reading the logs", "Tracing", "Narrowing it down", "Checking the stack",
        "Following the error", "Isolating", "Reproducing", "Correlating",
        "Checking timestamps", "Comparing states", "Working backwards",
        "Ruling things out", "Checking the obvious first", "Reading carefully",
        "Cross-referencing", "Looking upstream", "Checking the exit code",
        "Examining", "Retracing the steps", "Inspecting", "Reviewing",
        "Checking recent changes", "Testing the theory", "Confirming",
        "Getting to the bottom of it"
